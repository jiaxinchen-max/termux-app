prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: termux-render
Description: Android surface-based rendering bridge for Termux ecosystem
Version: @PROJECT_VERSION@
Libs: -L${libdir} -ltermux-render
Cflags: -I${includedir}/termux/render
