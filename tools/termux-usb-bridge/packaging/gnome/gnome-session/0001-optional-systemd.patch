Make systemd integration optional and retain upstream's null backend.
Android does not provide logind, journald, systemd boot or power operations.

--- a/meson_options.txt
+++ b/meson_options.txt
@@ -4,3 +4,5 @@
 option('docbook', type: 'boolean', value: true, description: 'build documentation')
 option('man', type: 'boolean', value: true, description: 'build documentation (requires xmlto)')
 option('x11', type: 'boolean', value: true, description: 'enable x11 session support')
+
+option('systemd', type: 'boolean', value: true, description: 'Build systemd integration (disable for rootless Android)')
--- a/meson.build
+++ b/meson.build
@@ -113,16 +113,20 @@
 
 session_bin_deps += dependency('gio-unix-2.0', version: glib_req_version)
 
-# Check for systemd
+# Optional systemd; non-systemd builds use upstream's existing null backend.
+have_systemd = get_option('systemd')
+config_h.set('HAVE_SYSTEMD', have_systemd)
 systemd_userunitdir = get_option('systemduserunitdir')
-if systemd_userunitdir == ''
-  systemd_dep = dependency('systemd', version: '>= 242', required: true)
-  systemd_userunitdir = systemd_dep.get_variable(pkgconfig: 'systemduserunitdir',
+if have_systemd
+  if systemd_userunitdir == ''
+    systemd_dep = dependency('systemd', version: '>= 242')
+    systemd_userunitdir = systemd_dep.get_variable(pkgconfig: 'systemduserunitdir',
                                                  pkgconfig_define: ['prefix', session_prefix])
+  endif
+  session_bin_deps += dependency('libsystemd', version: '>= 209')
+else
+  systemd_userunitdir = session_prefix / 'lib/systemd/user'
 endif
-
-libsystemd_dep = dependency('libsystemd', version: '>= 209', required: true)
-session_bin_deps += libsystemd_dep
 
