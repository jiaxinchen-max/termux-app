--- a/src/core/meta-context-main.c
+++ b/src/core/meta-context-main.c
@@ -21,6 +21,9 @@
 #include "config.h"
 
 #include "core/meta-context-main.h"
+#ifdef HAVE_ANDROID_BACKEND
+#include "backends/android/meta-backend-android.h"
+#endif
 
 #include <glib.h>
 #include <gio/gio.h>
@@ -495,6 +498,19 @@
 meta_context_main_create_backend (MetaContext  *context,
                                   GError      **error)
 {
+#ifdef HAVE_ANDROID_BACKEND
+  if (g_strcmp0 (g_getenv ("MUTTER_BACKEND"), "android") == 0)
+    {
+      if (meta_context_get_compositor_type (context) != META_COMPOSITOR_TYPE_WAYLAND)
+        {
+          g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                       "Android backend requires --wayland");
+          return NULL;
+        }
+      return g_initable_new (META_TYPE_BACKEND_ANDROID, NULL, error,
+                             "context", context, NULL);
+    }
+#endif
 #ifdef HAVE_WAYLAND
   MetaContextMain *context_main = META_CONTEXT_MAIN (context);
 #endif
