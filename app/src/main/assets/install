#!/data/data/com.termux/files/usr/bin/sh
set -eu

ASSET_TMP="${HOME}/.termux/tmp"
BRIDGE_DEB="$ASSET_TMP/termux-x11-nightly-1.04.10-0-all.deb"
trap 'rm -f "$ASSET_TMP/install" "$BRIDGE_DEB"' EXIT

export DEBIAN_FRONTEND=noninteractive
apt-get update -o APT::Update::Error-Mode=any
if ! dpkg-query -W -f='${db:Status-Status}\n' x11-repo 2>/dev/null | grep -qx installed; then
    apt-get install -y x11-repo
    apt-get update -o APT::Update::Error-Mode=any
fi
# Request the dependency explicitly so an already installed older copy is updated too.
apt-get install -y --reinstall --allow-downgrades "$BRIDGE_DEB" xkeyboard-config
