<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/local_games_success_container" />
            <stroke android:width="1dp" android:color="@color/local_games_success_outline" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/local_games_error_container" />
            <stroke android:width="1dp" android:color="@color/local_games_error_outline" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
