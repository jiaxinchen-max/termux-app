<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/local_games_background"
    android:orientation="vertical">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/game_detail_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/local_games_primary"
        app:trackColor="@color/local_games_surface_high" />

    <LinearLayout
        android:id="@+id/game_detail_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.78"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="168dp"
                app:cardBackgroundColor="@color/local_games_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/game_detail_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/local_games_bg_cover"
                    android:contentDescription="@string/local_game_cover_content_description"
                    android:padding="36dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/local_games_cover_placeholder" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/game_detail_title_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/local_games_on_surface"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_detail_change_cover"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:text="@string/local_game_detail_change_cover"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/local_games_outline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_detail_remove_cover"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:text="@string/local_game_detail_remove_cover"
                    android:textAllCaps="false"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_detail_runtime_profile"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/local_game_detail_runtime_action"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/local_games_outline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_detail_assets"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/local_game_detail_assets_action"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/local_games_outline" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_detail_launch"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:text="@string/local_game_detail_launch"
                android:textAllCaps="false"
                android:textColor="@color/local_games_background"
                android:textSize="13sp"
                app:backgroundTint="@color/local_games_primary"
                app:cornerRadius="14dp"
                app:icon="@drawable/local_games_ic_play"
                app:iconGravity="textStart"
                app:iconTint="@color/local_games_background" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1.22">

            <ScrollView
                android:id="@+id/game_detail_editor_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/local_game_detail_advanced"
                    android:textColor="@color/local_games_on_surface_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:cardBackgroundColor="@color/local_games_surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/game_detail_executable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="@color/local_games_on_surface_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/game_detail_root_uri"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:textColor="@color/local_games_on_surface_secondary"
                            android:textSize="10sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/game_detail_name_layout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:hint="@string/local_game_import_name"
                            app:boxBackgroundColor="@color/local_games_surface"
                            app:boxStrokeColor="@color/local_games_primary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/game_detail_name"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:gravity="center_vertical"
                                android:inputType="textCapWords"
                                android:maxLines="1"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/game_detail_working_directory_layout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="@string/local_game_import_working_directory"
                            app:boxBackgroundColor="@color/local_games_surface"
                            app:boxStrokeColor="@color/local_games_primary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/game_detail_working_directory"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:gravity="center_vertical"
                                android:fontFamily="monospace"
                                android:inputType="text"
                                android:maxLines="1"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/game_detail_arguments_layout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="@string/local_game_import_arguments"
                            app:boxBackgroundColor="@color/local_games_surface"
                            app:boxStrokeColor="@color/local_games_primary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/game_detail_arguments"
                                android:layout_width="match_parent"
                                android:layout_height="64dp"
                                android:fontFamily="monospace"
                                android:gravity="top"
                                android:inputType="text"
                                android:maxLines="2"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/game_detail_error"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/local_games_error"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/game_detail_save"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="10dp"
                            android:text="@string/local_game_detail_save"
                            android:textAllCaps="false"
                            android:textSize="13sp"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/local_games_outline" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/game_detail_delete"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:text="@string/local_game_detail_delete"
                            android:textAllCaps="false"
                            android:textColor="@color/local_games_error"
                            android:textSize="13sp"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/local_games_error" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/game_detail_storage_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/local_game_assets_title"
                        android:textColor="@color/local_games_on_surface_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:cardBackgroundColor="@color/local_games_surface"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/game_detail_storage_total"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/local_games_on_surface_secondary"
                                android:textSize="13sp" />

                            <LinearLayout
                                android:id="@+id/game_detail_storage_categories"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="vertical" />

                            <TextView
                                android:id="@+id/game_detail_storage_error"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:textColor="@color/local_games_error"
                                android:textSize="12sp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </ScrollView>

            <FrameLayout
                android:id="@+id/game_detail_runtime_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
</LinearLayout>
</LinearLayout>
