<?xml version="1.0" encoding="utf-8"?>
<!-- The "Runtime Emblem": a three-segment badge, a static neutral hub (orientation toggle,
     unchanged function) flanked by two independently status-colored blades (GLIBC / ROOTFS),
     each tappable to reset that environment. Blade color + breathing communicates readiness
     (see LocalGamesActivity#applyBladeState): red = not installed, amber = partially installed
     or a reset/install task is running, neutral (matches the hub) = ready and settled. This
     view is meant to be layered as a sibling of the toolbar inside a FrameLayout with a fixed
     width/height on the <include>, it is an overlay, not a child of the toolbar's own row. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="130.6dp"
    android:layout_height="21.8dp">

    <ImageView
        android:id="@+id/local_games_emblem_glibc_blade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/local_games_emblem_blade_glibc" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/local_games_emblem_hub" />

    <ImageView
        android:id="@+id/local_games_emblem_container_blade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/local_games_emblem_blade_container" />

    <ImageView
        android:id="@+id/local_games_emblem_glibc_icon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="18.5dp"
        android:layout_marginTop="4.9dp"
        android:importantForAccessibility="no"
        android:src="@drawable/local_games_ic_chip" />

    <ImageView
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="59.3dp"
        android:layout_marginTop="4.9dp"
        android:importantForAccessibility="no"
        android:src="@drawable/local_games_ic_orientation"
        android:tint="@color/local_games_on_surface" />

    <ImageView
        android:id="@+id/local_games_emblem_container_icon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="100.1dp"
        android:layout_marginTop="4.9dp"
        android:importantForAccessibility="no"
        android:src="@drawable/local_games_ic_cube" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <View
            android:id="@+id/local_games_emblem_glibc_tap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/local_games_emblem_glibc_description" />

        <View
            android:id="@+id/local_games_emblem_hub_tap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/local_games_switch_landscape_description" />

        <View
            android:id="@+id/local_games_emblem_container_tap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/local_games_emblem_rootfs_description" />

    </LinearLayout>

</FrameLayout>
