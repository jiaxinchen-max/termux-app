<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/runtime_backup_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/abc_ic_ab_back_material"
        app:title="@string/local_games_runtime_backup_title" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/runtime_backup_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/runtime_backup_export_glibc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/local_games_runtime_backup_export_glibc" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/runtime_backup_export_rootfs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/local_games_runtime_backup_export_rootfs" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/runtime_backup_restore"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/local_games_runtime_backup_restore" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/runtime_backup_view_process"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/local_games_runtime_backup_view_process"
                android:visibility="gone" />

            <TextView
                android:id="@+id/runtime_backup_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="?attr/colorError"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
