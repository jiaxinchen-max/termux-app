<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/local_games_background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/local_games_toolbar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/local_games_background"
            app:menu="@menu/local_games_help"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:title="@string/local_games_title"
            app:navigationIcon="@drawable/local_games_ic_back"
            app:navigationIconTint="@color/local_games_on_surface"
            app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6"
            app:titleTextColor="@color/local_games_on_surface" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/local_games_library_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/local_games_library_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="@string/local_games_library_eyebrow"
                        android:textColor="@color/local_games_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/local_games_page_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/local_games_pc_games"
                    android:textColor="@color/local_games_on_surface"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/local_games_shortcuts"
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/local_games_add_button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/local_games_bg_shortcut"
                        android:text="@string/local_games_import_hero_action"
                        android:textAllCaps="false"
                        android:textColor="@color/local_games_on_surface"
                        app:backgroundTint="@null"
                        app:icon="@drawable/local_games_ic_add"
                        app:iconGravity="textTop"
                        app:iconTint="@color/local_games_on_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/local_games_file_manager_button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/local_games_bg_shortcut"
                        android:text="@string/local_games_file_manager"
                        android:textAllCaps="false"
                        android:textColor="@color/local_games_on_surface"
                        app:backgroundTint="@null"
                        app:icon="@drawable/local_games_ic_folder"
                        app:iconGravity="textTop"
                        app:iconPadding="4dp"
                        app:iconSize="24dp"
                        app:iconTint="@color/local_games_on_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/local_games_settings_button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/local_games_bg_shortcut"
                        android:text="@string/local_games_shortcut_settings"
                        android:textAllCaps="false"
                        android:textColor="@color/local_games_on_surface"
                        app:backgroundTint="@null"
                        app:icon="@drawable/local_games_ic_settings"
                        app:iconGravity="textTop"
                        app:iconTint="@color/local_games_on_surface" />
                </LinearLayout>

                <TextView
                    android:id="@+id/local_games_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/local_games_library_heading"
                    android:textColor="@color/local_games_on_surface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/local_games_library_loading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:indeterminate="true"
                    app:indicatorColor="@color/local_games_primary"
                    app:trackColor="@color/local_games_surface_high" />

                <TextView
                    android:id="@+id/local_games_library_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/local_games_error"
                    android:visibility="gone" />

                <GridLayout
                    android:id="@+id/local_games_library_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:alignmentMode="alignMargins"
                    android:columnCount="2"
                    android:orientation="horizontal"
                    android:rowOrderPreserved="false"
                    android:useDefaultMargins="false" />

                <LinearLayout
                    android:id="@+id/local_games_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/local_games_empty_title"
                        android:textColor="@color/local_games_on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/local_games_empty_message"
                        android:textColor="@color/local_games_on_surface_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/local_games_components_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="0dp"
                android:paddingEnd="16dp"
                android:paddingBottom="28dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/local_games_component_task_console"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/local_games_component_view_process"
                    android:visibility="gone" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/local_games_components_loading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:indeterminate="true"
                    app:indicatorColor="@color/local_games_primary"
                    app:trackColor="@color/local_games_surface_high" />

                <TextView
                    android:id="@+id/local_games_components_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/local_games_error"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/local_games_component_sections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/local_games_settings_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:visibility="gone">

            <!-- The Settings menu rows are built by SettingsMenuBuilder for the current menu level. -->
            <LinearLayout
                android:id="@+id/local_games_settings_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="28dp" />
        </ScrollView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/local_games_navigation"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/local_games_surface"
        app:itemIconSize="23dp"
        app:itemIconTint="@color/local_games_navigation_tint"
        app:itemRippleColor="@color/local_games_surface_high"
        app:itemTextColor="@color/local_games_navigation_tint"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/local_games_bottom_navigation" />

</LinearLayout>
