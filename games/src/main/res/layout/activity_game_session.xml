<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/local_games_session_backdrop"
    android:keepScreenOn="true">

    <com.termux.x11.X11SessionView
        android:id="@+id/game_session_x11"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/game_session_waiting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/local_games_session_waiting"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/local_games_primary" />
        <TextView
            android:id="@+id/game_session_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/local_game_session_connecting"
            android:textColor="@color/local_games_on_surface"
            android:textSize="16sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/game_session_menu"
        android:layout_width="64dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:contentDescription="@string/local_game_session_menu"
        android:text="☰"
        android:textColor="@color/local_games_on_surface"
        android:textSize="20sp"
        app:backgroundTint="@color/local_games_overlay"
        app:cornerRadius="6dp" />

    <TextView
        android:id="@+id/game_session_input_warning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="78dp"
        android:background="@color/local_games_banner_error"
        android:padding="10dp"
        android:text="@string/local_game_session_input_unavailable"
        android:textColor="@color/local_games_on_error"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/game_session_drawer_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/local_games_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/game_session_drawer"
            android:layout_width="460dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@drawable/local_games_bg_overlay"
            android:clickable="true"
            android:orientation="horizontal"
            android:padding="@dimen/local_games_overlay_padding">

            <FrameLayout
                android:id="@+id/game_session_nav_host"
                android:layout_width="@dimen/local_games_overlay_nav_width"
                android:layout_height="match_parent">
            <HorizontalScrollView
                android:id="@+id/game_session_nav_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/game_session_nav"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="top"
                android:orientation="vertical">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_session_category_operation"
                    style="@style/Widget.TermuxLocalGames.OverlayNav"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/local_games_menu_row_min_height"
                    android:gravity="start|center_vertical"
                    android:text="@string/local_game_session_operation"
                    android:textAllCaps="false" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_session_category_performance"
                    style="@style/Widget.TermuxLocalGames.OverlayNav"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/local_games_menu_row_min_height"
                    android:gravity="start|center_vertical"
                    android:text="@string/local_game_session_performance"
                    android:textAllCaps="false" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_session_category_settings"
                    style="@style/Widget.TermuxLocalGames.OverlayNav"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/local_games_menu_row_min_height"
                    android:gravity="start|center_vertical"
                    android:text="@string/local_game_session_settings"
                    android:textAllCaps="false" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_session_category_keyboard"
                    style="@style/Widget.TermuxLocalGames.OverlayNav"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/local_games_menu_row_min_height"
                    android:gravity="start|center_vertical"
                    android:text="@string/local_game_session_keyboard"
                    android:textAllCaps="false" />
                <Space
                    android:id="@+id/game_session_nav_spacer"
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_session_exit"
                    style="@style/Widget.TermuxLocalGames.OverlayNav"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/local_games_menu_row_min_height"
                    android:gravity="start|center_vertical"
                    android:text="@string/local_game_session_exit"
                    android:textAllCaps="false"
                    android:textColor="@color/local_games_error" />
            </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/game_session_content"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/local_games_overlay_nav_gap"
                android:layout_weight="1"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/game_session_panel_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/local_game_session_operation_title"
                        android:textColor="@color/local_games_on_surface"
                        android:textSize="19sp"
                        android:fontFamily="sans-serif-medium" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/game_session_close_drawer"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/local_game_session_close"
                        android:text="×"
                        android:textColor="@color/local_games_on_surface"
                        android:textSize="22sp" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/game_session_panel_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="14dp"
                    android:layout_weight="1"
                    android:fillViewport="true">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:id="@+id/game_session_panel_operation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/local_game_session_input_summary"
                            android:textColor="@color/local_games_on_surface_secondary" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/game_session_input"
                            style="@style/Widget.TermuxLocalGames.OverlayRow"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/local_games_menu_row_min_height"
                            android:layout_marginTop="8dp"
                            android:gravity="start|center_vertical"
                            android:text="@string/local_game_session_input"
                            android:textAllCaps="false" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/game_session_processes"
                            style="@style/Widget.TermuxLocalGames.OverlayRow"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/local_games_menu_row_min_height"
                            android:layout_marginTop="8dp"
                            android:gravity="start|center_vertical"
                            android:text="@string/local_game_session_processes"
                            android:textAllCaps="false" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/game_session_logs"
                            style="@style/Widget.TermuxLocalGames.OverlayRow"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/local_games_menu_row_min_height"
                            android:layout_marginTop="8dp"
                            android:gravity="start|center_vertical"
                            android:text="@string/local_game_session_logs"
                            android:textAllCaps="false" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/game_session_panel_performance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <TextView
                            android:id="@+id/game_session_process_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/local_games_bg_panel"
                            android:padding="18dp"
                            android:text="@string/local_game_session_process_summary_pending"
                            android:textColor="@color/local_games_on_surface"
                            android:textSize="16sp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/game_session_process_refresh"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:text="@string/local_game_session_process_refresh"
                            android:textAllCaps="false" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/game_session_process_open"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="10dp"
                            android:text="@string/local_game_session_process_open"
                            android:textAllCaps="false" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/game_session_panel_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="18dp"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/local_game_session_brightness"
                            android:textColor="@color/local_games_on_surface" />
                        <SeekBar
                            android:id="@+id/game_session_brightness"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:max="100" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/local_game_session_volume"
                            android:textColor="@color/local_games_on_surface" />
                        <SeekBar
                            android:id="@+id/game_session_volume"
                            android:layout_width="match_parent"
                            android:layout_height="48dp" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/game_session_mouse_helper"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:text="@string/local_game_session_mouse_helper"
                            android:textColor="@color/local_games_on_surface" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/local_game_session_touch_sensitivity"
                            android:textColor="@color/local_games_on_surface" />
                        <SeekBar
                            android:id="@+id/game_session_touch_sensitivity"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:max="20" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/game_session_panel_keyboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/local_game_session_keyboard_summary"
                            android:textColor="@color/local_games_on_surface_secondary" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/game_session_keyboard"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="18dp"
                            android:text="@string/local_game_session_keyboard_open"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </FrameLayout>
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
