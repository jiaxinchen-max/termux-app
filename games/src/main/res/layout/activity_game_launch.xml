<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/local_games_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/game_launch_toolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/local_games_background"
        android:title="@string/local_game_launch_title"
        app:navigationIcon="@drawable/local_games_ic_back"
        app:navigationIconTint="@color/local_games_on_surface"
        app:titleTextColor="@color/local_games_on_surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingBottom="44dp">

        <TextView
            android:id="@+id/game_launch_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:textColor="@color/local_games_on_surface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/game_launch_stage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/local_games_on_surface_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/game_launch_progress_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textColor="@color/local_games_on_surface_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/game_launch_progress"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            app:indicatorColor="@color/local_games_primary"
            app:trackColor="@color/local_games_surface_high"
            app:trackCornerRadius="4dp" />

    </LinearLayout>
</LinearLayout>
