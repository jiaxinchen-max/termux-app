<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/local_games_bg_dialog"
    android:orientation="vertical"
    android:padding="12dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/game_launch_sheet_close"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="36dp"
        android:layout_height="28dp"
        android:layout_gravity="end"
        android:contentDescription="@string/local_games_close"
        android:text="×"
        android:textColor="@color/local_games_on_surface_secondary"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/game_launch_sheet_cover"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/local_games_bg_cover"
            android:contentDescription="@string/local_game_cover_content_description"
            android:padding="18dp"
            android:scaleType="centerCrop"
            android:src="@drawable/local_games_cover_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/game_launch_sheet_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/local_games_on_surface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/game_launch_sheet_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/local_games_success"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/local_game_launch_description_title"
        android:textColor="@color/local_games_on_surface"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/local_game_launch_description_empty"
        android:textColor="@color/local_games_on_surface_secondary"
        android:textSize="14sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/game_launch_sheet_layout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/local_game_launch_layout"
            android:gravity="center"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            app:cornerRadius="12dp"
            app:icon="@drawable/local_games_ic_more_actions"
            app:iconGravity="textStart"
            app:iconSize="24dp"
            app:iconTint="@color/local_games_primary"
            app:strokeColor="@color/local_games_outline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/game_launch_sheet_start"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/local_games_bg_primary_action"
            android:gravity="center"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="@string/local_game_detail_launch"
            android:textAllCaps="false"
            android:textColor="@color/local_games_on_surface"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>
</LinearLayout>
