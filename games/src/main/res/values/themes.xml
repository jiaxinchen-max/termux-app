<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TermuxLocalGames.DayNight.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/local_games_primary</item>
        <item name="colorPrimaryVariant">@color/local_games_primary_dark</item>
        <item name="colorSecondary">@color/local_games_secondary</item>
        <item name="colorSurface">@color/local_games_surface</item>
        <item name="colorOnSurface">@color/local_games_on_surface</item>
        <item name="colorOnPrimary">@color/local_games_background</item>
        <item name="colorError">@color/local_games_error</item>
        <item name="android:colorBackground">@color/local_games_background</item>
        <item name="android:windowBackground">@color/local_games_background</item>
        <item name="android:textColorPrimary">@color/local_games_on_surface</item>
        <item name="android:textColorSecondary">@color/local_games_on_surface_secondary</item>
        <item name="android:statusBarColor">@color/local_games_background</item>
        <item name="android:navigationBarColor">@color/local_games_background</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialButtonStyle">@style/Widget.TermuxLocalGames.Button</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Widget.TermuxLocalGames.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.TermuxLocalGames.HelpButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:minWidth">36dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textColor">@color/local_games_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ThemeOverlay.TermuxLocalGames.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorSurface">@color/local_games_surface</item>
        <item name="colorOnSurface">@color/local_games_on_surface</item>
        <item name="android:colorBackground">@color/local_games_surface</item>
        <item name="android:textColorPrimary">@color/local_games_on_surface</item>
        <item name="android:textColorSecondary">@color/local_games_on_surface_secondary</item>
    </style>
</resources>
