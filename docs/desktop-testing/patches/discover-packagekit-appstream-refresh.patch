+void PackageKitBackend::reconcileAppStreamResources()
+{
+    QHash<QString, QByteArray> signatures;
+    QHash<QString, QStringList> packageToApp;
+    const auto components = m_appdata->components().result();
+    for (const auto &component : components) {
+        if (component.packageNames().isEmpty()) {
+            continue;
+        }
+        AppStream::Metadata metadata;
+        metadata.setFormatStyle(AppStream::Metadata::FormatStyleCatalog);
+        metadata.addComponent(component);
+        signatures.insert(component.id(), QCryptographicHash::hash(
+            metadata.componentsToCatalog(AppStream::Metadata::FormatKindXml).toUtf8(), QCryptographicHash::Sha256));
+        for (const auto &package : component.packageNames()) {
+            auto &ids = packageToApp[package];
+            if (!ids.contains(component.id())) {
+                ids += component.id();
+            }
+        }
+    }
+
+    // A detail page or an old result stream may still hold these objects. Remove
+    // changed/removed metadata from the active index, but keep the QObject alive
+    // under this backend until shutdown. Unchanged metadata keeps object identity.
+    for (auto it = m_packages.packages.begin(); it != m_packages.packages.end();) {
+        auto resource = qobject_cast<AppPackageKitResource *>(it.value());
+        if (resource && (!signatures.contains(resource->appstreamId())
+                         || signatures.value(resource->appstreamId()) != m_componentSignatures.value(resource->appstreamId()))) {
+            it = m_packages.packages.erase(it);
+            Q_EMIT resourceRemoved(resource);
+        } else {
+            ++it;
+        }
+    }
+    for (auto it = m_packagesToAdd.begin(); it != m_packagesToAdd.end();) {
+        auto resource = qobject_cast<AppPackageKitResource *>(it.value());
+        if (resource && (!signatures.contains(resource->appstreamId())
+                         || signatures.value(resource->appstreamId()) != m_componentSignatures.value(resource->appstreamId()))) {
+            it = m_packagesToAdd.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    m_componentSignatures = std::move(signatures);
+    m_packages.packageToApp = std::move(packageToApp);
+    m_allPackagesLoaded = false;
 }
 
