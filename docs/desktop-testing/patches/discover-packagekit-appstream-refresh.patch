 void ConcurrentPool::loadAsync()
 {
-    QMutexLocker lock(&m_mutex);
-    return m_pool->loadAsync();
+    // Serialize the complete load with component queries. Pool::loadAsync only
+    // holds our mutex while scheduling its own worker, leaving queries able to
+    // observe the clear/rebuild interval on a subsequent load.
+    QtConcurrent::run(m_threadPool.get(), [this] {
+        QMutexLocker lock(&m_mutex);
+        return m_pool->load();
+    }).then(this, [this](bool success) {
+        Q_EMIT loadFinished(success);
+    });
 }
 
