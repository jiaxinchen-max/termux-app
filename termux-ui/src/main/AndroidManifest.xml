<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="com.termux.x11" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application>
        <provider
            android:name="com.termux.ui.files.BrowserDocumentsProvider"
            android:authorities="${applicationId}.game-browser.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <service android:name="com.termux.ui.wine.service.WineCDriveBackupService" android:exported="false" />
        <service
            android:name="com.termux.ui.desktop.service.DesktopArchiveForegroundService"
            android:exported="false"
            android:label="@string/desktop_title" />
        <activity
            android:name=".activity.LocalGamesActivity"
            android:exported="false"
            android:label="@string/local_games_title"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:theme="@style/Theme.TermuxLocalGames.DayNight.NoActionBar" />

        <activity
            android:name=".activity.RuntimeComponentVersionsActivity"
            android:exported="false"
            android:label="@string/local_games_tab_components"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:theme="@style/Theme.TermuxLocalGames.DayNight.NoActionBar" />

        <activity
            android:name=".activity.GameFileManagerActivity"
            android:exported="false"
            android:label="@string/local_game_file_manager_title"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:theme="@style/Theme.TermuxLocalGames.DayNight.NoActionBar" />

        <activity
            android:name="com.termux.ui.desktop.activity.DesktopActivity"
            android:exported="false"
            android:label="@string/desktop_title"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:theme="@style/Theme.TermuxLocalGames.DayNight.NoActionBar" />

        <activity
            android:name="com.termux.ui.desktop.activity.DesktopCreateActivity"
            android:exported="false"
            android:label="@string/desktop_create_native_title"
            android:resizeableActivity="true"
            android:theme="@style/Theme.TermuxLocalGames.DayNight.NoActionBar" />

        <activity
            android:name="com.termux.ui.desktop.activity.DesktopSessionActivity"
            android:exported="false"
            android:label="@string/desktop_title"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|density|screenLayout|keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.TermuxLocalGames.DayNight.Session" />

        <activity
            android:name="com.termux.ui.wine.activity.GameDetailActivity"
            android:exported="false"
            android:label="@string/local_game_detail_title"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:theme="@style/Theme.TermuxLocalGames.DayNight.NoActionBar" />

        <activity
            android:name="com.termux.ui.wine.activity.GameReauthorizeActivity"
            android:exported="false"
            android:label="@string/local_game_detail_title"
            android:resizeableActivity="true"
            android:theme="@style/Theme.TermuxLocalGames.DayNight.NoActionBar" />

        <activity
            android:name="com.termux.ui.wine.activity.GameRuntimeOptionsActivity"
            android:exported="false"
            android:label="@string/local_game_runtime_profile_title"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:theme="@style/Theme.TermuxLocalGames.DayNight.NoActionBar" />

        <activity
            android:name="com.termux.ui.wine.activity.GameAssetsActivity"
            android:exported="false"
            android:label="@string/local_game_assets_title"
            android:resizeableActivity="true"
            android:theme="@style/Theme.TermuxLocalGames.DayNight.NoActionBar" />

        <activity
            android:name="com.termux.ui.wine.activity.GameLaunchActivity"
            android:exported="false"
            android:label="@string/local_game_launch_title"
            android:resizeableActivity="true"
            android:theme="@style/Theme.TermuxLocalGames.DayNight.NoActionBar" />

        <activity
            android:name="com.termux.ui.wine.activity.GameSessionActivity"
            android:exported="false"
            android:label="@string/local_game_session_title"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|density|screenLayout|keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.TermuxLocalGames.DayNight.Session" />

        <service
            android:name=".service.ComponentTaskForegroundService"
            android:exported="false"
            android:label="@string/local_games_component_notification_title" />

        <service
            android:name="com.termux.ui.wine.service.LocalGameOrchestratorService"
            android:exported="false"
            android:label="@string/local_game_launch_notification_title" />

        <service
            android:name="com.termux.ui.wine.service.RootfsSetupForegroundService"
            android:exported="false"
            android:label="@string/local_games_runtime_setup_title" />

        <service
            android:name="com.termux.ui.wine.service.PrefixSetupForegroundService"
            android:exported="false"
            android:label="@string/local_games_prefix_setup_title" />

        <service
            android:name="com.termux.ui.wine.service.ResetRuntimeForegroundService"
            android:exported="false"
            android:label="@string/local_games_reset_title" />

        <service
            android:name="com.termux.ui.wine.service.RootfsBackupForegroundService"
            android:exported="false"
            android:label="@string/local_games_backup_title" />

        <service
            android:name=".service.CustomComponentInstallForegroundService"
            android:exported="false"
            android:label="@string/local_games_custom_component_install_title" />
    </application>

</manifest>
