<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet: rename (container only) + dropdown parameter rows + save/cancel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/local_games_surface"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/local_games_outline" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/desktop_settings_title"
        android:textColor="@color/local_games_on_surface"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/desktop_settings_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="2dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:textColor="@color/local_games_on_surface_secondary"
        android:textSize="12sp"
        tools:text="XFCE4 · native · changes apply on next session start" />

    <TextView
        android:id="@+id/desktop_settings_name_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/desktop_bg_option"
        android:lineSpacingExtra="4dp"
        android:padding="12dp"
        android:text="@string/desktop_settings_native_name_note"
        android:textColor="#7A5A2E"
        android:textSize="11sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/desktop_settings_name_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:hint="@string/desktop_create_name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/desktop_settings_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp"
        android:text="@string/desktop_create_section_display"
        android:textColor="#8A5A2B"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/desktop_settings_selects"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <include
            android:id="@+id/desktop_settings_resolution"
            layout="@layout/item_desktop_select" />

        <include
            android:id="@+id/desktop_settings_refresh"
            layout="@layout/item_desktop_select" />

        <include
            android:id="@+id/desktop_settings_renderer"
            layout="@layout/item_desktop_select" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/desktop_settings_save"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        android:text="@string/desktop_settings_save"
        android:textSize="15sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/desktop_settings_cancel"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:text="@string/desktop_settings_cancel"
        android:textColor="#8A5A2B"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
