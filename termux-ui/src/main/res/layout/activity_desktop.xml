<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/local_games_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/desktop_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/local_games_toolbar_height"
        android:title="@string/desktop_title"
        app:navigationIcon="@drawable/local_games_ic_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/local_games_page_horizontal_padding"
            android:paddingEnd="@dimen/local_games_page_horizontal_padding">

            <TextView
                android:id="@+id/desktop_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:text="@string/desktop_empty"
                android:textColor="@color/local_games_on_surface_secondary"
                android:visibility="gone" />

            <GridLayout
                android:id="@+id/desktop_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:alignmentMode="alignMargins"
                android:columnCount="2"
                android:orientation="horizontal"
                android:rowOrderPreserved="false"
                android:useDefaultMargins="false" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
