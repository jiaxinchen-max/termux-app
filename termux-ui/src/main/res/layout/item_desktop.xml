<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/local_games_surface" app:cardCornerRadius="4dp"
    app:cardElevation="0dp" app:strokeWidth="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <FrameLayout
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp">
            <ImageView android:id="@+id/desktop_cover"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/desktop_cover_ubuntu" android:src="@drawable/desktop_art_ubuntu"
                android:padding="0dp" android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
            <View android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/desktop_cover_shade" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:minHeight="52dp">
            <TextView android:id="@+id/desktop_mode_badge"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end" android:layout_margin="4dp"
                android:background="@color/local_games_surface" android:textColor="@color/local_games_on_surface"
                android:paddingStart="4dp" android:paddingEnd="4dp" android:textSize="8sp" />
            <TextView android:id="@+id/desktop_name"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="bottom" android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium" android:textSize="12sp"
                android:textColor="#FFFFFF" android:shadowColor="#99000000" android:shadowRadius="2" />
            </LinearLayout>
            <com.termux.ui.desktop.activity.DesktopInstallProgressView
                android:id="@+id/desktop_install_progress" android:layout_width="match_parent"
                android:layout_height="3dp" android:layout_gravity="bottom"
                android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:layout_marginBottom="3dp"
                android:visibility="gone" />
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="5dp">
            <TextView android:id="@+id/desktop_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/local_games_on_surface_secondary" android:textSize="9sp" />
            <TextView android:id="@+id/desktop_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="@color/local_games_success_text" android:textSize="9sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/desktop_primary"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:minWidth="48dp" android:minHeight="48dp"
                    android:insetTop="10dp" android:insetBottom="10dp"
                    android:paddingStart="7dp" android:paddingEnd="7dp"
                    android:textAllCaps="false" android:textSize="10sp" android:maxLines="2"
                    android:textColor="@color/local_games_on_primary"
                    app:backgroundTint="@color/local_games_primary" app:cornerRadius="6dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/desktop_more" style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="48dp" android:layout_height="48dp"
                    android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    android:text="⋯" android:textSize="18sp"
                    android:textColor="@color/local_games_on_surface_secondary"
                    android:contentDescription="@string/desktop_more" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
