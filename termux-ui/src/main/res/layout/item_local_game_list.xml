<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/local_games_surface"
    app:cardCornerRadius="4dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
        <ImageView android:id="@+id/local_game_cover"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginEnd="12dp" android:padding="8dp" android:scaleType="centerCrop"
            android:background="@drawable/local_games_bg_cover"
            android:src="@drawable/local_games_cover_placeholder"
            android:contentDescription="@string/local_game_cover_content_description" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/local_game_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="14sp"
            android:textColor="@color/local_games_on_surface" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/local_game_executable"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="11sp"
            android:textColor="@color/local_games_on_surface_secondary" />
        <TextView
                android:id="@+id/local_game_wine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/local_games_on_surface_secondary"
                android:textSize="10sp" />

            <TextView android:id="@+id/local_game_access_status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="11sp"
            android:textColor="@color/local_games_on_surface_secondary" />
        <TextView android:id="@+id/local_game_last_played"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="10sp"
            android:textColor="@color/local_games_on_surface_secondary" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="center">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/local_game_details"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="72dp" android:layout_height="40dp"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
            android:textAllCaps="false" android:textSize="12sp"
            android:textColor="@color/local_games_on_surface" android:text="@string/local_game_card_details" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/local_game_more"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="48dp" android:layout_height="40dp"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
            android:textAllCaps="false" android:textSize="12sp"
            android:textColor="@color/local_games_on_surface" android:contentDescription="@string/local_game_card_more" android:text="⋯" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
