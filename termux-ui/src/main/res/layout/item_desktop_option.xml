<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/desktop_option_root" android:layout_width="wrap_content"
    android:layout_height="wrap_content" android:minHeight="52dp"
    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
    <ImageView android:id="@+id/desktop_option_icon" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/desktop_art_ubuntu" android:padding="0dp"
        android:importantForAccessibility="no" />
    <View android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/desktop_cover_shade" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:minHeight="52dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="24dp">
            <TextView android:id="@+id/desktop_option_soon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="top|start" android:layout_margin="4dp" android:text="@string/desktop_card_created"
                android:background="@color/local_games_surface" android:textColor="@color/local_games_on_surface"
                android:paddingStart="3dp" android:paddingEnd="3dp" android:textSize="8sp" android:visibility="gone" />
            <TextView android:id="@+id/desktop_option_check" android:layout_width="18dp" android:layout_height="18dp"
                android:layout_gravity="top|end" android:layout_margin="3dp" android:gravity="center" android:text="✓"
                android:background="@drawable/desktop_bg_tab_on" android:textColor="@color/local_games_on_primary"
                android:textSize="11sp" android:visibility="gone" />
        </FrameLayout>
        <TextView android:id="@+id/desktop_option_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_marginBottom="10dp"
            android:textColor="#FFFFFF" android:textSize="12sp" android:fontFamily="sans-serif-medium"
            android:shadowColor="#99000000" android:shadowRadius="2" />
    </LinearLayout>
    <View android:id="@+id/desktop_option_selection" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/desktop_cover_selected" android:visibility="gone" android:importantForAccessibility="no" />
</FrameLayout>
