<?xml version="1.0" encoding="utf-8"?>
<!-- One desktop-environment / container choice row of the create screens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/desktop_option_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/desktop_bg_option"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="11dp"
    android:paddingEnd="12dp"
    android:paddingBottom="11dp">

    <TextView
        android:id="@+id/desktop_option_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:gravity="center"
        android:textSize="17sp"
        tools:ignore="HardcodedText"
        tools:text="🐭" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/desktop_option_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/local_games_on_surface"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="XFCE4" />

        <TextView
            android:id="@+id/desktop_option_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/local_games_on_surface_secondary"
            android:textSize="11sp"
            tools:text="Lightweight DE, XRender compositing on the host GPU" />
    </LinearLayout>

    <TextView
        android:id="@+id/desktop_option_soon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/local_games_bg_file_tile"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="@string/desktop_create_soon"
        android:textColor="@color/local_games_on_surface_secondary"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/desktop_option_check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/desktop_bg_tab_on"
        android:gravity="center"
        android:text="✓"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:visibility="gone"
        tools:ignore="HardcodedText" />
</LinearLayout>
