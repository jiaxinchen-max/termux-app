<?xml version="1.0" encoding="utf-8"?>
<!-- The "Add desktop" card: the last item of the Desktop grid, styled like the Library's
     "Import game" card (item_local_game_import.xml). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/desktop_add_card"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:contentDescription="@string/desktop_add"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="@dimen/local_games_import_card_min_height"
    app:cardBackgroundColor="@color/local_games_surface"
    app:cardCornerRadius="4dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/local_games_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:minHeight="@dimen/local_games_import_card_min_height"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/local_games_ic_add"
            app:tint="@color/local_games_on_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:letterSpacing="0.02"
            android:text="@string/desktop_add"
            android:textColor="@color/local_games_on_surface"
            android:textSize="11sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
