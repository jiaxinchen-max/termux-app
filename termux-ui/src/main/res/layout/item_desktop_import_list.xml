<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/desktop_import_card"
    android:contentDescription="@string/desktop_import"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/local_games_surface"
    app:cardCornerRadius="4dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="56dp" android:padding="12dp" android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:layout_marginEnd="12dp" android:importantForAccessibility="no"
            android:src="@drawable/local_games_ic_download" app:tint="@color/local_games_on_surface" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/desktop_import" android:textSize="14sp"
            android:fontFamily="sans-serif-medium" android:textColor="@color/local_games_on_surface"
            android:importantForAccessibility="no" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/desktop_import_more"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="48dp" android:layout_height="40dp" android:visibility="gone"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
            android:textAllCaps="false" android:textSize="12sp"
            android:textColor="@color/local_games_on_surface" android:contentDescription="@string/desktop_more" android:text="⋯" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
