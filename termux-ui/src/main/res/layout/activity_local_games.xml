<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/local_games_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/local_games_background"
    android:orientation="vertical">

    <!-- Landscape navigation (same three destinations as the bottom bar): one row of icon-only tabs
         at the very top of the content, as tall as the system status bar. LocalGamesActivity sets the
         height at run time (TopTabBarHeight; 24dp here is only the design-time default) and shows
         exactly one of this row and the bottom bar, depending on the window orientation. Each tab is
         a fixed local_games_top_tab_width wide and as tall as the row; the tabs run from the left
         (Library, File manager, Desktop, Settings) and the rest of the row stays empty. -->
    <LinearLayout
        android:id="@+id/local_games_top_tabs"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:background="@color/local_games_background"
        android:gravity="start"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/local_games_top_tab_library"
            android:layout_width="@dimen/local_games_top_tab_width"
            android:layout_height="match_parent"
            android:background="@drawable/local_games_bg_top_tab"
            android:clickable="true"
            android:contentDescription="@string/local_games_tab_library"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/local_games_ic_library"
            app:tint="@color/local_games_top_tab_tint" />

        <ImageView
            android:id="@+id/local_games_top_tab_file_manager"
            android:layout_width="@dimen/local_games_top_tab_width"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/local_games_top_tab_gap"
            android:background="@drawable/local_games_bg_top_tab"
            android:clickable="true"
            android:contentDescription="@string/local_games_file_manager"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/local_games_ic_folder"
            app:tint="@color/local_games_top_tab_tint" />

        <ImageView
            android:id="@+id/local_games_top_tab_desktop"
            android:layout_width="@dimen/local_games_top_tab_width"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/local_games_top_tab_gap"
            android:background="@drawable/local_games_bg_top_tab"
            android:clickable="true"
            android:contentDescription="@string/local_games_desktop"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/local_games_ic_desktop"
            app:tint="@color/local_games_top_tab_tint" />

        <ImageView
            android:id="@+id/local_games_top_tab_settings"
            android:layout_width="@dimen/local_games_top_tab_width"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/local_games_top_tab_gap"
            android:background="@drawable/local_games_bg_top_tab"
            android:clickable="true"
            android:contentDescription="@string/local_games_settings_title"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/local_games_ic_settings"
            app:tint="@color/local_games_top_tab_tint" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/local_games_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/local_games_toolbar_height"
            app:menu="@menu/local_games_help"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:title="@string/local_games_title"
            app:navigationIcon="@drawable/local_games_ic_back" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/local_games_library_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/local_games_library_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/local_games_page_horizontal_padding"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/local_games_page_horizontal_padding"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.04"
                        android:text="@string/local_games_library_eyebrow"
                        android:textColor="@color/local_games_primary_text"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

                <TextView
                    android:id="@+id/local_games_page_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/local_games_pc_games"
                    android:textColor="@color/local_games_on_surface"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/local_games_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/local_games_library_heading"
                    android:textColor="@color/local_games_on_surface"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/local_games_library_loading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:indeterminate="true"
                    app:indicatorColor="@color/local_games_primary"
                    app:trackColor="@color/local_games_surface_high" />

                <TextView
                    android:id="@+id/local_games_library_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/local_games_error"
                    android:visibility="gone" />

                <GridLayout
                    android:id="@+id/local_games_library_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:alignmentMode="alignMargins"
                    android:columnCount="2"
                    android:orientation="horizontal"
                    android:rowOrderPreserved="false"
                    android:useDefaultMargins="false" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/local_games_components_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/local_games_page_horizontal_padding"
                android:paddingTop="0dp"
                android:paddingEnd="@dimen/local_games_page_horizontal_padding"
                android:paddingBottom="28dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/local_games_component_task_console"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/local_games_component_view_process"
                    android:visibility="gone" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/local_games_components_loading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:indeterminate="true"
                    app:indicatorColor="@color/local_games_primary"
                    app:trackColor="@color/local_games_surface_high" />

                <TextView
                    android:id="@+id/local_games_components_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/local_games_error"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/local_games_component_sections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/local_games_settings_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:visibility="gone">

            <!-- The Settings menu rows are built by SettingsMenuBuilder for the current menu level. -->
            <LinearLayout
                android:id="@+id/local_games_settings_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/local_games_page_horizontal_padding"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/local_games_page_horizontal_padding"
                android:paddingBottom="28dp" />
        </ScrollView>
    </FrameLayout>

    <!-- One hairline separates the content from the bar; the bar itself is a single opaque layer
         in the page colour (no translucent fill, no elevation shadow/overlay), so light mode shows
         no lighter rectangle behind the icons and labels. -->
    <View
        android:id="@+id/local_games_navigation_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/local_games_outline"
        android:importantForAccessibility="no" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/local_games_navigation"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/local_games_background"
        android:elevation="0dp"
        app:elevation="0dp"
        app:itemIconSize="23dp"
        app:itemBackground="@drawable/local_games_bg_nav_item"
        app:itemIconTint="@color/local_games_navigation_tint"
        app:itemRippleColor="@android:color/transparent"
        app:itemTextColor="@color/local_games_navigation_tint"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/local_games_bottom_navigation" />

</LinearLayout>
