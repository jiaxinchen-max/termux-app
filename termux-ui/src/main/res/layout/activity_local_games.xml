<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/local_games_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/local_games_background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/local_games_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/local_games_toolbar_height"
            app:menu="@menu/local_games_help"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:title="@string/local_games_title"
            app:navigationIcon="@drawable/local_games_ic_back" />
    </FrameLayout>

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/local_games_library_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/local_games_toolbar_height" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/local_games_library_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/local_games_library_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/local_games_page_horizontal_padding"
                android:paddingTop="0dp"
                android:paddingEnd="@dimen/local_games_page_horizontal_padding"
                android:paddingBottom="28dp">

                <TextView
                    android:id="@+id/local_games_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/local_games_on_surface"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/local_games_library_loading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:indeterminate="true"
                    app:indicatorColor="@color/local_games_primary"
                    app:trackColor="@color/local_games_surface_high" />

                <TextView
                    android:id="@+id/local_games_library_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/local_games_error"
                    android:visibility="gone" />

                <GridLayout
                    android:id="@+id/local_games_library_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:alignmentMode="alignMargins"
                    android:columnCount="2"
                    android:orientation="horizontal"
                    android:rowOrderPreserved="false"
                    android:useDefaultMargins="false" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/local_games_components_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/local_games_page_horizontal_padding"
                android:paddingTop="0dp"
                android:paddingEnd="@dimen/local_games_page_horizontal_padding"
                android:paddingBottom="28dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/local_games_component_task_console"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/local_games_component_view_process"
                    android:visibility="gone" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/local_games_components_loading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:indeterminate="true"
                    app:indicatorColor="@color/local_games_primary"
                    app:trackColor="@color/local_games_surface_high" />

                <TextView
                    android:id="@+id/local_games_components_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/local_games_error"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/local_games_component_sections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/local_games_settings_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:visibility="gone">

            <!-- The Settings menu rows are built by SettingsMenuBuilder for the current menu level. -->
            <LinearLayout
                android:id="@+id/local_games_settings_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/local_games_page_horizontal_padding"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/local_games_page_horizontal_padding"
                android:paddingBottom="28dp" />
        </ScrollView>
    </FrameLayout>

</LinearLayout>
