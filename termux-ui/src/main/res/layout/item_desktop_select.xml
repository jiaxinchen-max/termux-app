<?xml version="1.0" encoding="utf-8"?>
<!-- Dropdown-style parameter row (resolution / refresh rate / renderer). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/desktop_select_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/desktop_bg_option"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="9dp"
    android:paddingEnd="14dp"
    android:paddingBottom="9dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/desktop_select_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/local_games_on_surface"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Resolution" />

        <TextView
            android:id="@+id/desktop_select_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/local_games_on_surface_secondary"
            android:textSize="12sp"
            tools:text="1280x720" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:text="›"
        android:textColor="#9A5B23"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />
</LinearLayout>
