<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/local_games_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/local_game_file_manager_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/local_games_toolbar_height"
        android:title="@string/local_game_file_manager_title"
        app:navigationIcon="@drawable/local_games_ic_back" />

    <TextView
        android:id="@+id/local_game_file_manager_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:maxLines="2"
        android:paddingStart="16dp"
        android:paddingTop="0dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
        android:textColor="@color/local_games_on_surface_secondary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingTop="2dp"
        android:paddingBottom="12dp">

        <GridLayout
            android:id="@+id/local_game_file_manager_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="6"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:useDefaultMargins="false" />
    </ScrollView>
</LinearLayout>
