<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape top tab background: the same warm nav indicator tint as the bottom navigation behind
     the selected tab (6 dp radius) and the same light press tint; nothing otherwise. The vertical
     inset is small because the bar is only as tall as the status bar. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset
            android:insetLeft="8dp"
            android:insetTop="2dp"
            android:insetRight="8dp"
            android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/local_games_nav_indicator" />
                <corners android:radius="6dp" />
            </shape>
        </inset>
    </item>
    <item android:state_pressed="true">
        <inset
            android:insetLeft="8dp"
            android:insetTop="2dp"
            android:insetRight="8dp"
            android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/local_games_surface_pressed" />
                <corners android:radius="6dp" />
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
