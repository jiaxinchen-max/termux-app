<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One height for every games toolbar (layouts and the programmatic runtime-options header). -->
    <dimen name="local_games_toolbar_height">56dp</dimen>
    <!-- Menu rows (title with optional summary and chevron), in the Settings / runtime-options menus
         (FrostedMenuRow) and in the in-game overlay: 48 dp. -->
    <dimen name="local_games_menu_row_min_height">48dp</dimen>
    <!-- The Save extended FAB: lower than the 48 dp Material default. -->
    <dimen name="local_games_save_button_min_height">40dp</dimen>
    <!-- In-game overlay drawer: outer padding, left navigation column and the gap to the panel
         (6-8 dp spacing system). -->
    <dimen name="local_games_overlay_padding">12dp</dimen>
    <dimen name="local_games_overlay_nav_width">104dp</dimen>
    <dimen name="local_games_overlay_nav_gap">8dp</dimen>
    <!-- Session log viewer: monospace line text size and the touch size of its Refresh button. -->
    <dimen name="local_games_log_text_size">11sp</dimen>
    <dimen name="local_games_log_button_size">48dp</dimen>
    <!-- Horizontal page padding shared by the Settings menu (activity_local_games) and the
         programmatic runtime-options page (GameRuntimeOptionsView), so their rows line up. -->
    <dimen name="local_games_page_horizontal_padding">16dp</dimen>
    <!-- Import card, the last item of the Library grid: never shorter than this, and stretched to the
         tallest game card in its grid row. -->
    <dimen name="local_games_import_card_min_height">75dp</dimen>
    <!-- Left/right inset of a Material dialog title panel; dialog content views (backup chooser)
         use the same value so they share the title's left edge. -->
    <dimen name="local_games_dialog_content_inset">24dp</dimen>
    <!-- Window dim behind dialogs while the dialog blur is active; FrostedWindow.DIM_WITH_BLUR uses
         the same value, so Material and self-drawn dialogs dim the page identically. -->
    <item name="local_games_dialog_dim_amount" format="float" type="dimen">0.30</item>
    <!-- Game detail: minimum touch target, portrait content width cap, landscape cover height and
         bottom padding that keeps the last control clear of the gesture bar. -->
    <dimen name="local_game_detail_touch_min">48dp</dimen>
    <dimen name="local_game_detail_content_max_width">600dp</dimen>
    <dimen name="local_game_detail_land_cover_height">132dp</dimen>
    <dimen name="local_game_detail_bottom_padding">36dp</dimen>
    <!-- Runtime options: bottom padding of the scrollable page so the last row scrolls above the
         extended Save FAB (48 dp tall + 16 dp margin) and the gesture bar. -->
    <dimen name="local_game_runtime_save_bar_clearance">88dp</dimen>
    <dimen name="local_game_runtime_fab_margin">16dp</dimen>
    <dimen name="local_game_runtime_touch_min">48dp</dimen>
    <!-- Launch status page: horizontal padding and the widest the status block may get. -->
    <dimen name="local_game_launch_side_padding">24dp</dimen>
    <dimen name="local_game_launch_content_max_width">480dp</dimen>
    <!-- Landscape Library top tab bar: its height is the system status bar height at run time
         (TopTabBarHeight); this is the fallback when the status bar height cannot be read. -->
    <dimen name="local_games_top_tabs_fallback_height">24dp</dimen>
    <!-- Each landscape top tab is this wide (compact: about twice the icon width) and as tall as the
         bar; the tabs sit left to right with this gap between them (none: they touch) instead of
         sharing the row equally. -->
    <dimen name="local_games_top_tab_width">34dp</dimen>
    <dimen name="local_games_top_tab_gap">0dp</dimen>
</resources>
